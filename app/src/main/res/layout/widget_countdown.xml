<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="8dp" android:background="@drawable/bg_widget">
    <TextView android:id="@+id/label" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="13sp"
        android:gravity="center" android:visibility="gone" />
    <TextView android:id="@+id/number" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0"
        android:textColor="#FFFFFF" android:textSize="52sp" android:textStyle="bold" />
</LinearLayout>
